{
  "name": "mystery-road-awe-2026",
  "version": "0.1.0",
  "private": true,
  "description": "Investigate the failure of an AI-assisted rehabilitation robot. Browser-based case-file investigation portal, built and tooled up across the CSDC Advanced Web Engineering exercises (Exercise 1: ES modules & refactoring; Exercise 2: build tooling, TypeScript, CI/CD).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "case-study",
    "vanilla-js",
    "web-engineering-course"
  ],
  "author": "Patrick Lukesch",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plukesch/Mystery-Road-AWE-2026-lukesch.git"
  },
  "bugs": {
    "url": "https://github.com/plukesch/Mystery-Road-AWE-2026-lukesch/issues"
  },
  "homepage": "https://github.com/plukesch/Mystery-Road-AWE-2026-lukesch#readme",
  "dependencies": {
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
